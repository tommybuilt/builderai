# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
# Next.js client uses NEXT_PUBLIC_ vars (non-sensitive)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Site URL (for SEO and sitemap)
NEXT_PUBLIC_SITE_URL=https://builderai.tools

# Cloudflare Turnstile (bot-protection challenges on submit, sign-in, claim, rating forms)
# Site key is public and is inlined into client chunks at build time.
# Secret key is server-side only and lives in the Cloudflare Pages dashboard env.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAADLlTUEQYi-jBE4U
# TURNSTILE_SECRET_KEY=<set in Cloudflare Pages dashboard, never commit>

# Optional: For admin seeding (only use in development)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================
# Email Notification Configuration (Resend)
# ============================================

# Resend API key for sending emails
# Get one at: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here

# Sender email address (must be from a verified domain in Resend)
# Example: noreply@builderai.tools
RESEND_FROM_EMAIL=noreply@builderai.tools

# Admin email to receive database activity notifications
ADMIN_NOTIFICATION_EMAIL=your-email@example.com

# Webhook secret for securing the notification endpoint (generate a random string)
NOTIFICATION_WEBHOOK_SECRET=your-random-secret-string-here
