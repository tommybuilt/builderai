{
  "name": "builderai-tools",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:cloudflare": "node scripts/cloudflare-prepare-env.mjs && npx @opennextjs/cloudflare build && node scripts/cloudflare-postbuild.mjs",
    "preview": "npx wrangler dev",
    "deploy": "npm run deploy:worker && npm run deploy:pages:proxy",
    "build:worker:ssr": "node scripts/cloudflare-prepare-env.mjs && npx @opennextjs/cloudflare build && node scripts/cloudflare-postbuild.mjs",
    "deploy:worker": "npx wrangler deploy --config wrangler.worker.toml",
    "deploy:pages:proxy": "npx wrangler pages deploy .pages-proxy --project-name builderai-tools --commit-dirty=true",
    "start": "next start",
    "lint": "next lint",
    "seed": "npx tsx scripts/seed.ts",
    "generate-favicons": "node scripts/generate-favicons.mjs",
    "generate-og": "node scripts/generate-og-image.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "next": "15.5.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-turnstile": "^1.1.5",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.16.2",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "esbuild": "0.24.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.21",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.49",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "wrangler": "^4.62.0"
  },
  "overrides": {
    "@opennextjs/cloudflare": {
      "esbuild": "0.24.2"
    },
    "@opennextjs/aws": {
      "esbuild": "0.24.2"
    }
  }
}
